{
  "name": "tribe-neon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "quality:preflight": "npm run lint && npm run typecheck && npm run verify:mock-asset-gacha && npm run verify:mock-direct-message-read && npm run verify:mock-gvg-cancellation && npm run verify:mock-secure-decks && npm run build",
    "test:e2e": "playwright test",
    "verify:asset-gacha": "node scripts/verify_asset_gacha.mjs",
    "verify:mock-asset-gacha": "node --experimental-strip-types scripts/verify_mock_asset_gacha.mjs",
    "verify:mock-direct-message-read": "node --experimental-strip-types scripts/verify_mock_direct_message_read.mjs",
    "verify:mock-gvg-cancellation": "node --experimental-strip-types scripts/verify_mock_gvg_cancellation.mjs",
    "verify:mock-secure-decks": "node --experimental-strip-types scripts/verify_mock_secure_decks.mjs",
    "verify:owner-rls": "node scripts/verify_owner_rls.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "jimp": "^1.6.1",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pngjs": "^7.0.0",
    "typescript": "^5"
  }
}
